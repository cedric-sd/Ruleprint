{
  "name": "ruleprint",
  "version": "0.1.0",
  "description": "Command-line interface: init, scan, serve and build a rule book from a repository.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "ruleprint-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "ruleprint": "./dist/bin.js"
  },
  "dependencies": {
    "@ruleprint/collector-annotations": "workspace:*",
    "@ruleprint/collector-ast": "workspace:*",
    "@ruleprint/collector-config": "workspace:*",
    "@ruleprint/collector-tests": "workspace:*",
    "@ruleprint/core": "workspace:*",
    "@ruleprint/spec": "workspace:*",
    "@ruleprint/ui": "workspace:*",
    "commander": "^14.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedric-sd/Ruleprint.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/cedric-sd/Ruleprint#readme",
  "bugs": "https://github.com/cedric-sd/Ruleprint/issues",
  "engines": {
    "node": ">=20.19.0"
  }
}
