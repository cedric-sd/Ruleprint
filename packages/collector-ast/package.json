{
  "name": "@ruleprint/collector-ast",
  "version": "0.0.0",
  "private": true,
  "description": "Collector that infers rules from conditionals in code, opt-in by directory, with domain-signal heuristics (tree-sitter).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "ruleprint-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ruleprint/core": "workspace:*",
    "@ruleprint/spec": "workspace:*",
    "@ruleprint/tree-sitter-utils": "workspace:*"
  }
}
