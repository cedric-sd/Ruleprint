{
  "name": "@ruleprint/collector-ast",
  "version": "0.1.0",
  "description": "Collector that infers rules from conditionals in code, opt-in by directory, with domain-signal heuristics (tree-sitter).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "ruleprint-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ruleprint/core": "workspace:*",
    "@ruleprint/spec": "workspace:*",
    "@ruleprint/tree-sitter-utils": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedric-sd/Ruleprint.git",
    "directory": "packages/collector-ast"
  },
  "homepage": "https://github.com/cedric-sd/Ruleprint#readme",
  "bugs": "https://github.com/cedric-sd/Ruleprint/issues",
  "publishConfig": {
    "access": "public"
  }
}
