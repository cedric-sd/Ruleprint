{
  "name": "@ruleprint/collector-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Collector that derives rules from vitest/jest test trees.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "ruleprint-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dogfood": "tsx scripts/dogfood.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ruleprint/core": "workspace:*",
    "@ruleprint/spec": "workspace:*",
    "@vscode/tree-sitter-wasm": "0.3.1"
  },
  "files": [
    "dist"
  ]
}
