{
  "name": "@ruleprint/core",
  "version": "0.1.0",
  "description": "Pure rule engine: merge, precedence, fingerprint and diff. No fs, no process, no network.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "ruleprint-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ruleprint/spec": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedric-sd/Ruleprint.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cedric-sd/Ruleprint#readme",
  "bugs": "https://github.com/cedric-sd/Ruleprint/issues",
  "publishConfig": {
    "access": "public"
  }
}
