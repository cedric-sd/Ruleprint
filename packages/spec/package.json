{
  "name": "@ruleprint/spec",
  "version": "0.0.0",
  "private": true,
  "description": "ruleprint.schema.json and the TypeScript types generated from it.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "ruleprint-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ruleprint.schema.json": {
      "ruleprint-source": "./src/ruleprint.schema.json",
      "default": "./dist/ruleprint.schema.json"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "generate": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "dist",
    "src/ruleprint.schema.json"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0"
  }
}
