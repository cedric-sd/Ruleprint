{
  "name": "@ruleprint/tree-sitter-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tree-sitter loader, literal helpers and AST normalisation for the collectors.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "ruleprint-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1"
  }
}
